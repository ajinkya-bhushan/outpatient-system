# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  copy to .env and fill in your values
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Whisper (local inference) ─────────────────────────────────────────────────
# Available sizes: tiny | base | small | medium | large | large-v2 | large-v3
# Default is "base" – suitable for local testing without heavy hardware.
WHISPER_MODEL=base

# Inference device: cpu | cuda | mps (Apple Silicon)
WHISPER_DEVICE=cpu

# Optional: pin a language (e.g. "en") or leave empty for auto-detection
WHISPER_LANGUAGE=

# Task: transcribe (keep original language) | translate (always to English)
WHISPER_TASK=transcribe

# ── OpenAI hosted Whisper (optional engine) ───────────────────────────────────
# Only required if you add the OpenAI engine and set ENGINE=openai
OPENAI_API_KEY=sk-replace-me

# ── API limits ────────────────────────────────────────────────────────────────
MAX_AUDIO_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Default engine ────────────────────────────────────────────────────────────
# whisper | whisperflow | openai | faster_whisper
DEFAULT_ENGINE=whisper

# ── FastAPI server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Streamlit ─────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
