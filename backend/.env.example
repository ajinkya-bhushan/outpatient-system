# Copy to .env. Never commit real secrets.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=10200
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ── Database (users table for auth) ───────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRE_SECONDS=28800

# ── Speech-to-text (sst_v1 FastAPI service) ───────────────────────────────────
STT_BASE_URL=http://127.0.0.1:8000
STT_TIMEOUT_SECONDS=120
DEFAULT_STT_ENGINE=whisper

# ── AWS Comprehend Medical ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=

# ── Aava SOAP generation agent ────────────────────────────────────────────────
AAVA_JWT_TOKEN=
AAVA_EXECUTE_ENDPOINT=https://int-ai.aava.ai/agents/execute/agent-executions
AAVA_HISTORY_ENDPOINT=https://int-ai.aava.ai/agents/execute/history/execution
AAVA_AGENT_ID=54818
AAVA_POLL_INTERVAL_SECONDS=10
AAVA_POLL_TIMEOUT_SECONDS=600

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_TRANSCRIPT_CHARS=20000
MAX_AUDIO_SIZE_MB=50
