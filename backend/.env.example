# Copy to .env. Never commit real secrets.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=10200
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ── Database (users table for auth) ───────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRE_SECONDS=28800

# ── Speech-to-text engine ─────────────────────────────────────────────────────
# local  = load SpeechBrain + Whisper in this process (needs: uv sync --extra stt)
# remote = proxy to the sst_v1 FastAPI service at STT_BASE_URL
STT_ENGINE_MODE=local

# Only used when STT_ENGINE_MODE=remote
STT_BASE_URL=http://127.0.0.1:8000
STT_TIMEOUT_SECONDS=120
DEFAULT_STT_ENGINE=whisper

# ── Local inference: device and models ────────────────────────────────────────
STT_DEVICE=auto
# Load models at startup instead of on first request (slower boot, no first-hit stall)
STT_MODEL_PRELOAD=false
WHISPER_MODEL=small.en
WHISPER_BACKEND=faster_whisper
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=en

# ── Local inference: speaker diarization ──────────────────────────────────────
DIARIZATION_ENABLED=true
# Outpatient encounters are usually clinician + patient. Leave blank to let the
# eigen-gap heuristic estimate the count, which is measurably less reliable.
DIARIZATION_NUM_SPEAKERS=2
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=6
DIARIZATION_WINDOW_SEC=1.5
DIARIZATION_SHIFT_SEC=0.75
DIARIZATION_VAD_SOURCE=speechbrain/vad-crdnn-libriparty
DIARIZATION_EMBEDDING_SOURCE=speechbrain/spkrec-ecapa-voxceleb

# ── Local storage ─────────────────────────────────────────────────────────────
# Encounter audio is PHI. Defaults live under backend/data/ and are gitignored.
AUDIO_STORAGE_DIR=./data/audio
MODEL_CACHE_DIR=./data/models

# ── Object storage for persisted audio/transcript artifacts ──────────────────
# local = use AUDIO_STORAGE_DIR only
# minio = use S3-compatible MinIO, keeping only request temp files on local disk
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=docconnect
OBJECT_STORAGE_SECRET_KEY=docconnect-dev-password
OBJECT_STORAGE_BUCKET=docconnect-encounters
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_PREFIX=stt-jobs

# Used by docker-compose for the MinIO root account.
MINIO_ROOT_USER=docconnect
MINIO_ROOT_PASSWORD=docconnect-dev-password

# ── AWS Comprehend Medical ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=

# ── Aava SOAP generation agent ────────────────────────────────────────────────
AAVA_JWT_TOKEN=
AAVA_EXECUTE_ENDPOINT=https://int-ai.aava.ai/agents/execute/agent-executions
AAVA_HISTORY_ENDPOINT=https://int-ai.aava.ai/agents/execute/history/execution
AAVA_AGENT_ID=54818
AAVA_POLL_INTERVAL_SECONDS=10
AAVA_POLL_TIMEOUT_SECONDS=600

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_TRANSCRIPT_CHARS=20000
MAX_AUDIO_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=3600
